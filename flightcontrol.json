{
  "$schema": "https://app.flightcontrol.dev/schema.json",
  "environments": [
    {
      "id": "production",
      "name": "Production",
      "region": "eu-west-2",
      "source": {
        "branch": "main"
      },
      "services": [
        {
          "id": "api",
          "name": "API",
          "type": "fargate",
          "buildType": "docker",
          "dockerfilePath": "apps/api/Dockerfile",
          "dockerContext": ".",
          "domain": "api.way-finderz.com",
          "port": 3000,
          "cpu": 0.25,
          "memory": 0.5,
          "minInstances": 1,
          "maxInstances": 2,
          "healthCheckPath": "/health",
          "envVariables": {
            "NODE_ENV": "production",
            "ALLOWED_ORIGINS": "https://way-finderz.com,https://www.way-finderz.com",
            "API_PORT": "3000",
            "DATABASE_URL": {
              "fromService": {
                "id": "db",
                "value": "dbConnectionString"
              }
            },
            "BETTER_AUTH_SECRET": {
              "fromParameterStore": "fc.wayfinderz.env.cmkv2yrw90p6f3qt74bopb43v.p08s12d9.BETTER_AUTH_SECRET"
            },
            "BETTER_AUTH_URL": {
              "fromParameterStore": "fc.wayfinderz.env.cmkv2yrw90p6f3qt74bopb43v.p18t12cr.BETTER_AUTH_URL"
            },
            "RESEND_API_KEY": {
              "fromParameterStore": "fc.wayfinderz.env.cmkv2yrw90p6f3qt74bopb43v.9mdr08j5.RESEND_API_KEY"
            },
            "EMAIL_FROM": "Way Finderz <noreply@way-finderz.com>",
            "INNGEST_EVENT_KEY": {
              "fromParameterStore": "fc.wayfinderz.env.cmkv2yrw90p6f3qt74bopb43v.bgt513gp.INNGEST_EVENT_KEY"
            },
            "INNGEST_SIGNING_KEY": {
              "fromParameterStore": "fc.wayfinderz.env.cmkv2yrw90p6f3qt74bopb43v.bgt613e2.INNGEST_SIGNING_KEY"
            },
            "MOCK_EMAILS": "false",
            "FRONTEND_URL": {
              "fromService": {
                "id": "web",
                "value": "origin"
              }
            }
          }
        },
        {
          "id": "web",
          "name": "Web",
          "type": "static",
          "buildType": "nixpacks",
          "domain": "way-finderz.com",
          "basePath": ".",
          "installCommand": "pnpm install",
          "buildCommand": "pnpm --filter api build && pnpm --filter web build",
          "outputDirectory": "apps/web/out",
          "singlePageApp": false,
          "dependsOn": [
            "api"
          ],
          "envVariables": {
            "NEXT_PUBLIC_API_URL": "https://api.way-finderz.com"
          }
        },
        {
          "id": "db",
          "name": "Database",
          "type": "rds",
          "engine": "postgres",
          "engineVersion": "16",
          "instanceSize": "db.t4g.micro",
          "storage": 20,
          "private": true
        }
      ]
    }
  ]
}