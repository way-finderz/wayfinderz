{
  "name": "@way-finderz/api",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    "./trpc": {
      "types": "./dist/trpc/router.d.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --emitDeclarationOnly && node esbuild.config.mjs",
    "start": "node dist/index.js",
    "worker:email": "tsx src/workers/email-worker.ts",
    "worker:email:prod": "node dist/workers/email-worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:reset": "tsx src/scripts/db-reset.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:seed:admin": "tsx src/scripts/seed-admin.ts",
    "db:seed:game": "tsx src/scripts/seed-game.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.975.0",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^13.1.0",
    "@trpc/server": "^11.8.1",
    "@types/koa": "^2.15.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa-ratelimit": "^5.0.5",
    "@types/koa__cors": "^5.0.0",
    "@types/koa__router": "^12.0.4",
    "@types/node": "^25.0.9",
    "@way-finderz/shared": "workspace:*",
    "better-auth": "^1.2.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.41.0",
    "esbuild": "^0.27.2",
    "koa": "^3.0.0",
    "koa-bodyparser": "^4.4.1",
    "koa-ratelimit": "^6.0.0",
    "pino": "^10.3.0",
    "postgres": "^3.4.0",
    "typescript": "^5.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.4",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "vitest": "^4.0.17"
  }
}