# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/way_finderz

# BetterAuth
# Generate a secure secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your-32-character-secret-key-here
BETTER_AUTH_URL=http://localhost:3000

# API
API_PORT=3000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3001

# Email Configuration
# Set to "true" to log emails to console instead of sending via AWS SES
MOCK_EMAILS=true

# AWS Configuration (required when MOCK_EMAILS=false)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Optional: For LocalStack local development
# AWS_ENDPOINT_URL=http://localhost:4566

# SES Configuration
SES_FROM_EMAIL=Way Finderz <noreply@wayfinderz.com>

# SQS Configuration
SQS_EMAIL_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/way-finderz-emails
