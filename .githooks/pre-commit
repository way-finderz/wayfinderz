#!/bin/bash

# Pre-commit hook to prevent committing .env files with secrets

# Check for .env files being staged (excluding .env.example files)
ENV_FILES=$(git diff --cached --name-only | grep -E '^\.env$|^\.env\.[^e]|/\.env$|/\.env\.[^e]' | grep -v '\.example')

if [ -n "$ENV_FILES" ]; then
    echo "ERROR: Attempting to commit .env file(s) that may contain secrets:"
    echo ""
    echo "$ENV_FILES"
    echo ""
    echo "These files should not be committed to version control."
    echo "If you're sure these files don't contain secrets, you can bypass this check with:"
    echo "  git commit --no-verify"
    echo ""
    exit 1
fi

exit 0
