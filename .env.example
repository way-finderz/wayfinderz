# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/way_finderz
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=way_finderz
DB_PORT=5432

# BetterAuth
# Generate a secure secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your-32-character-secret-key-here
BETTER_AUTH_URL=http://localhost:3000

# API
API_PORT=3000
NODE_ENV=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000

# CORS
FRONTEND_URL=http://localhost:3001
# Optional: comma-separated list of allowed origins for CORS
# ALLOWED_ORIGINS=http://localhost:3001,https://yourdomain.com

# Admin User (required for seed script)
# Password must be at least 12 characters
ADMIN_EMAIL=admin@way-finderz.com
ADMIN_PASSWORD=your-secure-password-here
ADMIN_NAME=Admin

# Email Configuration
# Set to "true" to log emails to console instead of sending via AWS SES
MOCK_EMAILS=true

# AWS Configuration (required when MOCK_EMAILS is false)
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Optional: For LocalStack local development
# AWS_ENDPOINT_URL=http://localhost:4566

# SES Configuration
SES_FROM_EMAIL=Way Finderz <noreply@wayfinderz.com>

# SQS Configuration
SQS_EMAIL_QUEUE_URL=https://sqs.eu-west-2.amazonaws.com/123456789/way-finderz-emails
