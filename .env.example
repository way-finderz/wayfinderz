# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/way_finderz
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=way_finderz
DB_PORT=5432

# BetterAuth
# Generate a secure secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your-32-character-secret-key-here
BETTER_AUTH_URL=http://localhost:3000

# API
API_PORT=3000
NODE_ENV=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000

# CORS
FRONTEND_URL=http://localhost:3001
# Optional: comma-separated list of allowed origins for CORS
# ALLOWED_ORIGINS=http://localhost:3001,https://yourdomain.com

# Admin User (required for seed script)
# Password must be at least 12 characters
ADMIN_EMAIL=admin@way-finderz.com
ADMIN_PASSWORD=your-secure-password-here
ADMIN_NAME=Admin

# Email Configuration
# Set to "true" to log emails to console instead of sending via Resend
MOCK_EMAILS=true

# Resend Configuration (required when MOCK_EMAILS is false)
# Get your API key from https://resend.com
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Way Finderz <noreply@way-finderz.com>

# Inngest Configuration (required when MOCK_EMAILS is false)
# Get keys from https://inngest.com
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key
